APP_NAME="KortexTools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost
APP_INSTALLED=false
COOKIE_CONSENT_ENABLED=true
APP_VERSION=3.3.2
FRONT_THEME=canvas
APP_ADMIN_PREFIX=admin
APP_LOCALE=en
FALLBACK_LOCALE=null
APP_FALLBACK_LOCALE=en
ARTISAN_LOCALES=en
SUPER_ADMIN_ROLE=1

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
IGNITION_EDITOR=vscode
DEBUGBAR_ENABLED=false
SYSTEM_TIMEZONE=America/Tijuana

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kortextools
DB_USERNAME=kortextools
DB_PASSWORD=secret

BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

FILESYSTEM_DRIVER=public
FILESYSTEM_DISK="${FILESYSTEM_DRIVER}"
UPLOADER_TEMP_DISK=local
UPLOADER_TEMP_PATH=temp
PUBLIC_FILES_DISK="${FILESYSTEM_DRIVER}"
PUBLIC_FILES_PATH=uploads
UPLOADER_CHUNKS_PATH=uploads/chunks

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=php
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@monsterseotools.com
MAIL_FROM_NAME=${APP_NAME}

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WAS_ACCESS_KEY_ID=
WAS_SECRET_ACCESS_KEY=
